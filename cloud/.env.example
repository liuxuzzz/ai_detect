# AI质量检测云端可选配置。首次部署直接运行 docker compose up -d --build 即可。
# 只有需要自定义地址、端口或外部数据库时，才复制为 .env 并修改对应项目。
# 留空的密码/密钥会自动随机生成并保存在 runtime_secrets 数据卷，重启时复用。
# SMTP、GitHub、Google 及注册开关、上传限额在网站「管理中心 → 站点设置」配置。
# 全新数据库不预置管理员：首个成功注册的账号自动成为超级管理员。

# 对外访问地址：留空时浏览器自动使用当前服务器 IP/主机名 + SERVER_PORT。
# 前端地址无需配置：管理员首次网页登录时自动记录，可在后台「站点设置」修改。
# 后端对外 API 地址，浏览器和客户端均使用它，不能填写 Docker 内部服务名。
WEB_API_BASE_URL=
# IP 示例：WEB_API_BASE_URL=http://192.0.2.10:8081
# Cloudflare/反向代理示例（替换上面的 API 地址，域名后无需添加本机监听端口）：
# WEB_API_BASE_URL=https://api.example.com
# 请分别将两个域名转发到 web 与 server。HTTPS 前端必须使用 HTTPS API。
# OAuth 回调地址在后台展示，使用这里配置的 API 域名；请原样填写到 GitHub/Google。

# 宿主机监听地址与端口只影响 Docker 发布，不决定上面的公网 URL。
# 经本机 Cloudflare Tunnel/反向代理访问时可以把监听地址改为 127.0.0.1。
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
SERVER_BIND_ADDRESS=0.0.0.0
SERVER_PORT=8081

# PostgreSQL（只在 Compose 内部联网，不公开数据库端口）。
POSTGRES_DB=aijiance
POSTGRES_USER=aijiance
# 留空会自动生成；也可以填自己的数据库密码。
# 已有数据库修改此变量不会自动修改数据库密码，升级时保持原密码。
POSTGRES_PASSWORD=
DATABASE_POOL_SIZE=8

# 签名与加密密钥：留空会自动生成独立随机密钥，之后保持稳定。
# 修改 JWT_SECRET 会使会话失效；修改加密密钥会导致已保存的 Client Key/SMTP/OAuth 密钥无法解密。
JWT_SECRET=
CLIENT_KEY_ENCRYPTION_SECRET=

# 每人每天可创建的云端测试任务数；客户端上传限额在后台单独配置，默认每天 100 次。
TASK_DAILY_LIMIT=20
# 日志级别：error、warn、info、debug。
RUST_LOG=info

# DATABASE_URL 留空时，后端自动使用上面的 POSTGRES_* 与已保存的密码连接内置数据库。
# 使用外部 PostgreSQL 或直接 cargo run 时，填完整连接地址（密码中的特殊字符须 URL 编码）。
DATABASE_URL=
# 内置 Redis 使用 Docker 服务名；外部 Redis 或本地开发改成实际主机地址。
REDIS_URL=redis://redis:6379
# 以下只用于直接 cargo run 的监听配置。Compose 内部固定 8080/prod，宿主机端口由 SERVER_PORT 配置。
BIND_ADDRESS=0.0.0.0:8081
APP_ENV=local
